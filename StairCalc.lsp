;;; Staircase Calculator for AutoCAD / ZWCAD
;;; Filename: StairCalc.lsp
;;; Version: 3.1 - Final

(vl-load-com)

(setq *stair:units-list* 
  '(("Millimeters (mm)" . 0) ("Centimeters (cm)" . 1) ("Meters (m)" . 2) 
    ("Inches (in)" . 3) ("Feet (ft)" . 4) ("Feet-Inches (ft-in)" . 5) ("Yards (yd)" . 6))
)
(setq *stair:dcl-fname* "")
(setq *stair:dcl-id* -1)
(setq *stair:result* nil)

(defun c:STAIRCALC ()
  (stair:ensure-dcl)
  (setq dcl-id (load_dialog *stair:dcl-fname*))
  (if (< dcl-id 0) (progn (princ "\nError: Could not load DCL file.") (exit)))
  (setq *stair:dcl-id* dcl-id)
  (if (not (new_dialog "staircalc" dcl-id))
    (progn (princ "\nError: Could not start dialog.") (unload_dialog dcl-id) (exit)))
  (stair:init-dialog)
  (stair:setup-callbacks)
  (start_dialog)
  (unload_dialog dcl-id)
  (princ)
)

(defun stair:ensure-dcl (/ f)
  (setq *stair:dcl-fname* (vl-filename-mktemp "staircalc" nil ".dcl"))
  (if (not (findfile *stair:dcl-fname*))
    (progn
      (setq f (open *stair:dcl-fname* "w"))
      (stair:write-dcl f)
      (close f)
    )
  )
)

