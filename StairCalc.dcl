; Staircase Calculator DCL Dialog Definition
; Auto-generated by StairCalc.lsp - can be used standalone

staircalc : dialog {
  label = "Staircase Calculator";
  
  : column {
    label = "Calculation Mode";
    : radio_column {
      key = "calc_mode";
      : radio_button { key = "mode_ceil_slab"; label = "Ceiling Height + Slab Height \U+2192 Riser"; }
      : radio_button { key = "mode_riser_slab"; label = "Riser + Slab Height (default 9\") \U+2192 Ceiling Height"; }
    }
  }
  
  : boxed_column {
    label = "Inputs";
    : row {
      : edit_box { key = "ceiling_ht"; label = "Ceiling Height"; edit_width = 15; }
      : popup_list { key = "ceiling_unit"; width = 12; }
    }
    : row {
      : edit_box { key = "slab_ht"; label = "Slab Thickness"; edit_width = 15; }
      : popup_list { key = "slab_unit"; width = 12; }
    }
    : row {
      : edit_box { key = "riser_ht"; label = "Riser Height"; edit_width = 15; }
      : popup_list { key = "riser_unit"; width = 12; }
    }
    : row {
      : edit_box { key = "tread_d"; label = "Tread Depth"; edit_width = 15; }
      : popup_list { key = "tread_unit"; width = 12; }
    }
  }
  
  : boxed_column {
    label = "Results";
    : text { key = "result_riser"; label = "Riser Height: "; }
    : text { key = "result_tread"; label = "Tread Depth: "; }
    : text { key = "result_ceiling"; label = "Ceiling Height: "; }
    : text { key = "result_slab"; label = "Slab Thickness: "; }
    : text { key = "result_risers"; label = "Number of Risers: "; }
    : text { key = "result_treads"; label = "Number of Treads: "; }
    : text { key = "result_total_run"; label = "Total Run: "; }
    : text { key = "result_total_rise"; label = "Total Rise: "; }
    : text { key = "result_unit"; label = "Display Unit: "; }
  }
  
  : boxed_column {
    label = "Display Unit";
    : popup_list { key = "disp_unit"; width = 20; }
    : toggle { key = "auto_unit"; label = "Auto-detect from INSUNITS"; value = "1"; }
    : toggle { key = "auto_notation"; label = "Auto-detect ' and \" notation"; value = "1"; }
  }
  
  : row {
    : button { key = "calc"; label = "Calculate"; is_default = true; width = 12; }
    : button { key = "draw"; label = "Draw Stair"; width = 12; }
    : button { key = "clear"; label = "Clear"; width = 12; }
    : button { key = "cancel"; label = "Close"; is_cancel = true; width = 12; }
  }
}